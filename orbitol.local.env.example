# Copy to orbitol.local.env (gitignored) and fill in. One `export KEY=value` per line; values are literal paths
# (no spaces, quotes or $). The environment wins over this file; ORBITOL_LOCAL_ENV=<file> replaces it.
# Check what Orbitol resolves: PYTHONPATH=$PWD python -m orbitol.contracts

# Required. Data, tables, caches and NequIP models, laid out as in docs/datasets.md (the release bundle's layout).
export ORBITOL_DATA_HOME=/path/to/orbitol_data
# Required for training (default --out-root), posthoc queues and Slurm reports.
export ORBITOL_RUNS_ROOT=/path/to/orbitol_runs

# Optional: one artifact outside the ORBITOL_DATA_HOME layout. Keys: ORBITOL_TABLES_DIR, ORBITOL_NEQUIP_TS,
# ORBITOL_NEQUIP_OEQ, ORBITOL_<MP20|ALEX_MP20>_<DATA_ROOT|ORBIT_CACHE_DIR|ATOM_CACHE_DIR|SYMMETRY_REFERENCE|PHASE_DIAGRAM>
# export ORBITOL_MP20_PHASE_DIAGRAM=/path/to/2023-02-07-ppd-mp.pkl
# Optional: the pinned Crystalite core (default external/crystalite-03603fe, cloned by tools/setup_env.sh).
# export ORBITOL_CORE_ROOT=/path/to/crystalite-03603fe
# Optional: W&B entity (default: your W&B default entity).
# export ORBITOL_WANDB_ENTITY=my-entity

# Slurm jobs (slurm/*.sbatch). Interpreter default: .venv/bin/python from tools/setup_env.sh.
# export ORBITOL_PYTHON=/path/to/python
# export ORBITOL_BASE_PYTHON=/path/to/base/python
# export ORBITOL_TORCH_CUDA_ARCH_LIST=8.9
# OEQ JIT build (default NequIP backend): a script that puts gcc >= 12 on PATH, and the CUDA toolkit.
# export ORBITOL_GCC_ENABLE=/path/to/enable
# export ORBITOL_CUDA_HOME=/path/to/cuda
# Optional placement per job class and log directory; unset means cluster defaults. Use slurm/submit.
# export ORBITOL_SLURM_GPU_PARTITION=gpu-partition
# export ORBITOL_SLURM_GPU_ACCOUNT=my-gpu-account
# export ORBITOL_SLURM_CPU_PARTITION=cpu-partition
# export ORBITOL_SLURM_CPU_ACCOUNT=my-cpu-account
# export ORBITOL_SLURM_LOG_DIR=/path/to/orbitol_runs/slurm
